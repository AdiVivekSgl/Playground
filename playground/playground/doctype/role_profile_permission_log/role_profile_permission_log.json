{
 "doctype": "DocType",
 "name": "Role Profile Permission Log",
 "module": "Playground",
 "custom": 0,
 "is_submittable": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "title_field": "role_profile",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 0,
 "description": "Immutable audit record written each time a Role Profile permission workbook is applied (see playground.playground.role_profile_permissions.apply_import). Captures who applied which file (name + sha256), the anchor profile, the profiles it touched, per-category change counts, and the full structured diff as JSON. Rows are created programmatically only - never by hand - and are not editable.",
 "field_order": [
  "naming_series", "role_profile", "profiles_touched", "column_break_hdr", "applied_by", "applied_on",
  "file_section", "file_name", "file_hash", "column_break_file", "workbook",
  "summary_section", "roles_added", "roles_removed", "perms_added", "column_break_summary", "perms_updated", "perms_removed",
  "diff_section", "diff_json"
 ],
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Series", "options": "RPPL-.YYYY.-.#####", "default": "RPPL-.YYYY.-.#####", "reqd": 1, "print_hide": 1},
  {"fieldname": "role_profile", "fieldtype": "Link", "options": "Role Profile", "label": "Role Profile", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1, "description": "The profile the workbook was launched from (its anchor)."},
  {"fieldname": "profiles_touched", "fieldtype": "Small Text", "label": "Profiles Touched", "read_only": 1, "description": "All Role Profiles whose membership this apply changed (comma-separated)."},
  {"fieldname": "column_break_hdr", "fieldtype": "Column Break"},
  {"fieldname": "applied_by", "fieldtype": "Link", "options": "User", "label": "Applied By", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "applied_on", "fieldtype": "Datetime", "label": "Applied On", "read_only": 1, "in_list_view": 1},

  {"fieldname": "file_section", "fieldtype": "Section Break", "label": "Workbook"},
  {"fieldname": "file_name", "fieldtype": "Data", "label": "File Name", "read_only": 1},
  {"fieldname": "file_hash", "fieldtype": "Data", "label": "File Hash (SHA-256)", "read_only": 1, "description": "sha256 of the applied workbook bytes; also verified against the preview to reject a swapped file."},
  {"fieldname": "column_break_file", "fieldtype": "Column Break"},
  {"fieldname": "workbook", "fieldtype": "Attach", "label": "Workbook File", "read_only": 1, "description": "The exact .xlsx that was applied, kept for reproducibility."},

  {"fieldname": "summary_section", "fieldtype": "Section Break", "label": "Change Summary"},
  {"fieldname": "roles_added", "fieldtype": "Int", "label": "Role Memberships Added", "read_only": 1, "in_list_view": 1},
  {"fieldname": "roles_removed", "fieldtype": "Int", "label": "Role Memberships Removed", "read_only": 1, "in_list_view": 1},
  {"fieldname": "perms_added", "fieldtype": "Int", "label": "Permissions Added", "read_only": 1},
  {"fieldname": "column_break_summary", "fieldtype": "Column Break"},
  {"fieldname": "perms_updated", "fieldtype": "Int", "label": "Permissions Updated", "read_only": 1},
  {"fieldname": "perms_removed", "fieldtype": "Int", "label": "Permissions Removed", "read_only": 1},

  {"fieldname": "diff_section", "fieldtype": "Section Break", "label": "Diff"},
  {"fieldname": "diff_json", "fieldtype": "Code", "options": "JSON", "label": "Applied Diff (JSON)", "read_only": 1, "description": "The full structured diff that was applied - memberships, per-permission changes and blast-radius impact."}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "create": 1, "delete": 1, "report": 1, "export": 1}
 ]
}
