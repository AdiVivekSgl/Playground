# Copy to .env (never commit .env) and fill in. See README.md.

# Frappe site and the same value you set as wa_akg_secret in Frappe Cloud site config.
FRAPPE_URL=https://YOUR-SITE.frappe.cloud
FRAPPE_WA_AKG_SECRET=

# WA-AKG API key (WA-AKG dashboard -> API Keys). Used to send the reply.
WA_AKG_API_KEY=
# WA-AKG as seen from inside Docker (container name on the wa-akg_default network).
WA_AKG_URL=http://wa-akg-app:3000

# Secret you give WA-AKG when registering the webhook; it signs every webhook with it.
WEBHOOK_SECRET=

# Optional: only answer these numbers (comma-separated, international format).
# Strongly recommended while testing so nobody else messaging the number gets bot replies.
ALLOWED_NUMBERS=
# Optional: only handle these WA-AKG session ids (comma-separated). Empty = all sessions.
SESSION_IDS=

LOG_LEVEL=INFO
